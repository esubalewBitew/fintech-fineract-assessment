              "raw": "{\n  \"external_reference\": \"ERP-PM-{{run_id}}\",\n  \"code\": \"9{{run_id}}\",\n  \"name\": \"Postman test account\",\n  \"type\": \"ASSET\",\n  \"usage\": \"DETAIL\",\n  \"currency\": \"RWF\"\n}"
            },
            "url": "{{mock_erp_url}}/accounts"
