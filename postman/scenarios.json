    {
      "name": "03 \u2014 Scenario C/D Happy path (client \u2192 disburse \u2192 repay)",
      "description": "Run Refresh run_id first, then this folder top-to-bottom.",
      "item": [
        {
          "name": "1 Sync CoA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{integration_api_key}}"
              }
            ],
            "url": "{{integration_url}}/sync/coa"
