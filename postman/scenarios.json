        {
          "name": "Post balanced journal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{mock_erp_api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reference\": \"JRN-PM-{{run_id}}\",\n  \"entry_date\": \"{{today}}\",\n  \"description\": \"Postman balanced journal\",\n  \"source_system\": \"postman\",\n  \"lines\": [\n    { \"account_external_reference\": \"ERP-LOAN-PORT\", \"debit\": \"1000\", \"credit\": \"0\" },\n    { \"account_external_reference\": \"ERP-CASH\", \"debit\": \"0\", \"credit\": \"1000\" }\n  ]\n}"
            },
            "url": "{{mock_erp_url}}/journal-entries",
            "description": "Expect 201. Replay same body \u2192 200/409 idempotent."
          }
        },
        {
          "name": "Post unbalanced journal (expect 422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('unbalanced rejected', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([422, 400]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{mock_erp_api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reference\": \"JRN-UNBAL-{{run_id}}\",\n  \"entry_date\": \"{{today}}\",\n  \"lines\": [\n    { \"account_external_reference\": \"ERP-CASH\", \"debit\": \"100\", \"credit\": \"0\" },\n    { \"account_external_reference\": \"ERP-LOAN-PORT\", \"debit\": \"0\", \"credit\": \"50\" }\n  ]\n}"
            },
            "url": "{{mock_erp_url}}/journal-entries"
          }
        },
        {
          "name": "List journals",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{mock_erp_api_key}}"
              }
            ],
            "url": {
              "raw": "{{mock_erp_url}}/journal-entries",
              "host": [
                "{{mock_erp_url}}"
              ],
              "path": [
                "journal-entries"
              ],
              "query": [
                {
                  "key": "external_reference",
                  "value": "{{disburse_ref}}",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get journal by ref",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{mock_erp_api_key}}"
              }
            ],
            "url": "{{mock_erp_url}}/journal-entries/{{disburse_ref}}"
          }
        },
        {
          "name": "ERP fault \u2192 none",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{mock_erp_api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"none\"\n}"
            },
            "url": "{{mock_erp_url}}/admin/faults"
          }
        },
        {
          "name": "ERP fault \u2192 down",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{mock_erp_api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"down\"\n}"
            },
            "url": "{{mock_erp_url}}/admin/faults",
            "description": "Use before disburse for Part J ERP-down scenario. Always reset to none after."
          }
        }
      ]
    },
