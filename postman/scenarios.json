{
  "info": {
    "_postman_id": "a1b2c3d4-fintech-fineract-assessment",
    "name": "fintech-fineract-assessment-scenarios",
    "description": "Scenario folders: bootstrap, Mock ERP, Integration catalog, C/D, F, J, K, E.\nEnv: Local. Run Refresh run_id before money flows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "integration_url",
      "value": "http://localhost:8082"
    },
    {
      "key": "mock_erp_url",
      "value": "http://localhost:8081"
    },
    {
      "key": "integration_api_key",
      "value": "integration-key"
    },
    {
      "key": "mock_erp_api_key",
      "value": "mock-erp-key"
    }
  ],
  "item": [
    {
      "name": "00 \u2014 Bootstrap",
      "item": [
        {
          "name": "Refresh run_id (set unique refs)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rid = Date.now().toString(36).slice(-6);",
                  "const today = new Date().toISOString().slice(0, 10);",
                  "pm.environment.set('run_id', rid);",
                  "pm.environment.set('today', today);",
                  "pm.environment.set('client_uid', 'CLI-PM-' + rid);",
                  "pm.environment.set('loan_reference', 'LOAN-PM-' + rid);",
                  "pm.environment.set('disburse_ref', 'DISB-PM-' + rid);",
                  "pm.environment.set('repay_ref', 'REPAY-PM-' + rid);",
                  "pm.environment.set('reverse_ref', 'REV-PM-' + rid);",
                  "pm.environment.set('correlation_id', 'corr-' + rid);",
                  "pm.environment.set('principal', '500000');",
                  "console.log('run_id=' + rid + ' loan=' + pm.environment.get('loan_reference'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('run_id set', function () {",
                  "  pm.expect(pm.environment.get('run_id')).to.be.ok;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{integration_url}}/health",
            "description": "Generates unique `run_id`, client/loan/money refs, and today's date into the active environment."
          }
        },
        {
          "name": "Integration health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{integration_url}}/health"
          }
        },
        {
          "name": "Mock ERP health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mock_erp_url}}/health"
          }
        },
        {
          "name": "Sync CoA (A-sync)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CoA sync 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.count).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{integration_api_key}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{correlation_id}}"
              }
            ],
            "url": "{{integration_url}}/sync/coa",
            "description": "ERP \u2192 Fineract GL sync. Run twice for Part A-sync idempotency (second = already_mapped)."
          }
        },
        {
          "name": "Sync CoA again (idempotent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('second sync has no created', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const results = pm.response.json().results || [];",
                  "  const created = results.filter(r => r.status === 'created');",
                  "  pm.expect(created.length).to.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{integration_api_key}}"
              }
            ],
            "url": "{{integration_url}}/sync/coa"
          }
        }
      ]
    },
    {
