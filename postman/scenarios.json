              ],
              "query": [
                {
                  "key": "external_reference",
                  "value": "{{disburse_ref}}"
                }
              ]
            }
          }
        },
        {
          "name": "7 Repay (partial)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{integration_api_key}}"
              },
              {
                "key": "Content-Type",
