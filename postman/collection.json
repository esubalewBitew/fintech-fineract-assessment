{
  "info": {
    "name": "fintech-fineract-assessment",
    "description": "ERP CoA \u2192 sync \u2192 Fineract Part B \u2192 client/loan \u2192 money \u2192 reconcile.\nEnv: Local. Disable SSL verify for https://localhost:8443. Run 00 Refresh first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 \u2014 Bootstrap",
      "item": [
        {
          "name": "Refresh run_id (unique partner keys)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{integration_url}}/health",
            "description": "Sets run_id, client_uid, loan_reference, disburse_ref, repay_ref, today, correlation_id, principal=500000"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rid = Date.now().toString(36).slice(-6);",
                  "const today = new Date().toISOString().slice(0, 10);",
                  "pm.environment.set('run_id', rid);",
                  "pm.environment.set('today', today);",
                  "pm.environment.set('client_uid', 'CLI-PM-' + rid);",
                  "pm.environment.set('loan_reference', 'LOAN-PM-' + rid);",
                  "pm.environment.set('disburse_ref', 'DISB-PM-' + rid);",
                  "pm.environment.set('repay_ref', 'REPAY-PM-' + rid);",
                  "pm.environment.set('reverse_ref', 'REV-PM-' + rid);",
                  "pm.environment.set('correlation_id', 'corr-' + rid);",
                  "pm.environment.set('principal', '500000');",
                  "console.log('refs', rid, pm.environment.get('loan_reference'), pm.environment.get('disburse_ref'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Integration health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{integration_url}}/health",
            "description": ""
          }
        },
        {
          "name": "Mock ERP health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mock_erp_url}}/health",
            "description": ""
          }
        },
        {
          "name": "Fineract actuator health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "https://localhost:8443/fineract-provider/actuator/health",
            "description": "Expect UP. Turn off SSL verification in Postman settings."
          }
        }
      ]
    },
