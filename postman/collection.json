    {
      "name": "02 \u2014 Integration: Sync CoA (ERP \u2192 Fineract GL)",
      "description": "",
      "item": [
        {
          "name": "POST /sync/coa (1st run)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{integration_api_key}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{correlation_id}}"
              }
            ],
            "url": "{{integration_url}}/sync/coa",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "console.log('statuses', (j.results||[]).map(r => r.status + ':' + r.external_reference));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /sync/coa (2nd run idempotent)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{integration_api_key}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{correlation_id}}"
              }
            ],
            "url": "{{integration_url}}/sync/coa",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('no new creates', function() {",
                  "  pm.response.to.have.status(200);",
                  "  const created = (pm.response.json().results||[]).filter(r => r.status==='created');",
                  "  pm.expect(created.length).to.eql(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 \u2014 Fineract Part B (office / currency / product)",
      "description": "These call Fineract directly (same as make setup-part-b). Not exposed on Integration Service.",
      "item": [
        {
          "name": "GET currencies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Fineract-Platform-TenantId",
                "value": "{{fineract_tenant}}"
              }
            ],
            "url": "{{fineract_url}}/currencies",
            "description": "",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{fineract_user}}"
                },
                {
                  "key": "password",
                  "value": "{{fineract_password}}"
                }
              ]
            }
          }
        },
        {
          "name": "PUT currencies (enable RWF keep USD)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Fineract-Platform-TenantId",
                "value": "{{fineract_tenant}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{fineract_url}}/currencies",
            "description": "Enables RWF for the tenant (Part B).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currencies\": [\n    \"RWF\",\n    \"USD\"\n  ]\n}"
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{fineract_user}}"
                },
                {
                  "key": "password",
                  "value": "{{fineract_password}}"
                }
              ]
            }
          }
        },
        {
          "name": "GET offices",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Fineract-Platform-TenantId",
                "value": "{{fineract_tenant}}"
              }
            ],
            "url": "{{fineract_url}}/offices",
            "description": "",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{fineract_user}}"
                },
                {
                  "key": "password",
                  "value": "{{fineract_password}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const offices = pm.response.json() || [];",
                  "const kigali = offices.find(o => o.name==='Kigali' || o.externalId==='KIGALI');",
                  "if (kigali) pm.environment.set('office_id', String(kigali.id));",
                  "else if (offices[0]) pm.environment.set('office_id', String(offices[0].id));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST office Kigali (skip if exists \u2192 use GET)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Fineract-Platform-TenantId",
                "value": "{{fineract_tenant}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{fineract_url}}/offices",
            "description": "If already exists Fineract may error \u2014 then use office_id from GET offices.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kigali\",\n  \"parentId\": 1,\n  \"externalId\": \"KIGALI\",\n  \"openingDate\": \"2010-01-01\",\n  \"dateFormat\": \"yyyy-MM-dd\",\n  \"locale\": \"en\"\n}"
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{fineract_user}}"
                },
                {
                  "key": "password",
                  "value": "{{fineract_password}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  const id = j.resourceId || j.officeId;",
                  "  if (id) pm.environment.set('office_id', String(id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET glaccounts (resolve IDs for product)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Fineract-Platform-TenantId",
                "value": "{{fineract_tenant}}"
              }
            ],
            "url": "{{fineract_url}}/glaccounts",
            "description": "Must run AFTER CoA sync. Saves gl_*_id env vars used by product create.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{fineract_user}}"
                },
                {
                  "key": "password",
                  "value": "{{fineract_password}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('listed', () => pm.response.to.have.status(200));",
                  "const accounts = pm.response.json() || [];",
                  "const byCode = {};",
                  "accounts.forEach(a => { if (a.glCode) byCode[a.glCode] = a.id; });",
                  "const map = {",
                  "  '1000': 'gl_fund_source_id',",
                  "  '1100': 'gl_loan_portfolio_id',",
                  "  '1200': 'gl_transfers_id',",
                  "  '4002': 'gl_interest_income_id',",
                  "  '4001': 'gl_fee_income_id',",
                  "  '5001': 'gl_write_off_id',",
                  "  '2100': 'gl_overpayment_id'",
                  "};",
                  "Object.keys(map).forEach(code => {",
                  "  if (byCode[code]) pm.environment.set(map[code], String(byCode[code]));",
                  "});",
                  "console.log('GL ids', Object.fromEntries(Object.values(map).map(k => [k, pm.environment.get(k)])));",
                  "pm.test('required GLs present', function() {",
                  "  pm.expect(pm.environment.get('gl_fund_source_id')).to.be.ok;",
                  "  pm.expect(pm.environment.get('gl_loan_portfolio_id')).to.be.ok;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET loanproducts (find SME Asset Finance)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Fineract-Platform-TenantId",
                "value": "{{fineract_tenant}}"
              }
            ],
            "url": "{{fineract_url}}/loanproducts",
            "description": "",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{fineract_user}}"
                },
                {
                  "key": "password",
                  "value": "{{fineract_password}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const products = pm.response.json() || [];",
                  "const p = products.find(x => x.name==='SME Asset Finance' || x.externalId==='SME-ASSET-FINANCE');",
                  "if (p) { pm.environment.set('product_id', String(p.id)); console.log('existing product', p.id); }"
                ]
              }
            }
          ]
        },
        {
