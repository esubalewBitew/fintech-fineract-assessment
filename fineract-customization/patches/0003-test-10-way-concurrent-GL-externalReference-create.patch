+
+    /**
+     * Ten parallel creates with the same externalReference hit the unique-constraint race path. The resolver returns
+     * one existing id for every caller (Mockito unit test — not a real DB).
+     */
+    @Test
+    void tenParallelCreatesSameExternalReferenceYieldOneAccount() throws Exception {
+        ReflectionTestUtils.setField(glAccountWritePlatformService, "self", glAccountWritePlatformService);
+
+        final String json = "{\"name\":\"Loan Receivable\",\"glCode\":\"1200\",\"type\":1,\"usage\":1,"
+                + "\"manualEntriesAllowed\":true,\"externalReference\":\"GL-1200\"}";
+        final GLAccountCommand accountCommand = new GLAccountCommand(null, "Loan Receivable", null, "1200", false, true, 1, 1, "x", null,
+                "GL-1200");
+
+        when(fromApiJsonDeserializer.commandFromApiJson(anyString())).thenReturn(accountCommand);
+        when(glAccountRepository.findOneByExternalReference("GL-1200")).thenReturn(Optional.empty());
+        when(glAccountRepository.saveAndFlush(any(GLAccount.class))).thenThrow(new DataIntegrityViolationException("insert failed",
+                new RuntimeException("duplicate key value violates unique constraint \"uk_acc_gl_external_reference\"")));
+        when(conflictResolver.resolveAfterUniqueViolation(eq("GL-1200"), any(GLAccountCommand.class)))
+                .thenReturn(new CommandProcessingResultBuilder().withEntityId(99L).build());
+
+        final JsonElement element = JsonParser.parseString(json);
+        final JsonCommand command = JsonCommand.fromJsonElement(null, element, new FromJsonHelper());
+
+        final ExecutorService pool = Executors.newFixedThreadPool(10);
+        final CountDownLatch start = new CountDownLatch(1);
+        final CountDownLatch done = new CountDownLatch(10);
+        final AtomicInteger success = new AtomicInteger();
+        final AtomicInteger conflict = new AtomicInteger();
+        final AtomicInteger unexpected = new AtomicInteger();
+        final List<Long> ids = Collections.synchronizedList(new ArrayList<>());
+
+        for (int i = 0; i < 10; i++) {
+            pool.submit(() -> {
+                try {
+                    start.await();
+                    final CommandProcessingResult result = glAccountWritePlatformService.createGLAccount(command);
+                    ids.add(result.getResourceId());
+                    success.incrementAndGet();
+                } catch (GLAccountExternalReferenceConflictException e) {
+                    conflict.incrementAndGet();
+                } catch (Exception e) {
+                    unexpected.incrementAndGet();
+                } finally {
+                    done.countDown();
+                }
+            });
+        }
+
+        start.countDown();
+        assertTrue(done.await(30, TimeUnit.SECONDS), "all threads should finish within 30s");
+        pool.shutdown();
+
+        assertEquals(10, success.get());
+        assertEquals(0, conflict.get());
+        assertEquals(0, unexpected.get());
+        assertEquals(10, ids.size());
+        assertTrue(ids.stream().allMatch(id -> Long.valueOf(99L).equals(id)));
+    }
