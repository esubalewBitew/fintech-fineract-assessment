+package org.apache.fineract.accounting.glaccount.service;
+
+import lombok.RequiredArgsConstructor;
+import org.apache.fineract.accounting.glaccount.command.GLAccountCommand;
+import org.apache.fineract.accounting.glaccount.domain.GLAccount;
+import org.apache.fineract.accounting.glaccount.domain.GLAccountRepository;
+import org.apache.fineract.accounting.glaccount.exception.GLAccountExternalReferenceConflictException;
+import org.apache.fineract.accounting.glaccount.exception.GLAccountExternalReferenceRaceException;
+import org.apache.fineract.infrastructure.core.data.CommandProcessingResult;
+import org.apache.fineract.infrastructure.core.data.CommandProcessingResultBuilder;
+import org.springframework.stereotype.Component;
+import org.springframework.transaction.annotation.Propagation;
+import org.springframework.transaction.annotation.Transactional;
+
+@Component
+@RequiredArgsConstructor
+public class GLAccountExternalReferenceConflictResolver {
+
+    private final GLAccountRepository glAccountRepository;
+
+    @Transactional(propagation = Propagation.REQUIRES_NEW)
+    public CommandProcessingResult resolveAfterUniqueViolation(final String externalReference, final GLAccountCommand accountCommand) {
+        final GLAccount existing = this.glAccountRepository.findOneByExternalReference(externalReference)
+                .orElseThrow(() -> new GLAccountExternalReferenceRaceException(externalReference));
+        if (GLAccountExternalReferencePayloadComparator.isIdentical(existing, accountCommand)) {
+            return new CommandProcessingResultBuilder().withEntityId(existing.getId()).build();
+        }
+        throw new GLAccountExternalReferenceConflictException(externalReference);
+    }
+}
