+package org.apache.fineract.accounting.glaccount.service;
+
+import java.util.Objects;
+import org.apache.fineract.accounting.glaccount.command.GLAccountCommand;
+import org.apache.fineract.accounting.glaccount.domain.GLAccount;
+
+public final class GLAccountExternalReferencePayloadComparator {
+
+    private GLAccountExternalReferencePayloadComparator() {}
+
+    /** Compare business payload. externalReference is the lookup key and is not compared. */
+    public static boolean isIdentical(final GLAccount existing, final GLAccountCommand command) {
+        return Objects.equals(existing.getGlCode(), command.glCode()) && Objects.equals(existing.getName(), command.name())
+                && Objects.equals(existing.getType(), command.type()) && Objects.equals(existing.getUsage(), command.usage())
+                && Objects.equals(nullToZero(parentId(existing)), nullToZero(command.parentId()))
+                && Objects.equals(normalize(existing.getDescription()), normalize(command.description()));
+    }
+
+    private static Long parentId(final GLAccount account) {
+        return account.getParent() == null ? null : account.getParent().getId();
+    }
+
+    private static Long nullToZero(final Long value) {
+        return value == null ? 0L : value;
+    }
+
+    private static String normalize(final String value) {
+        return value == null || value.isBlank() ? null : value.trim();
+    }
+}
